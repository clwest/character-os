auto-install-peers=true
strict-peer-dependencies=false
# pnpm 11+ pre-script verification triggers a `pnpm install` which
# halts on the (advisory) "ignored builds" warning for esbuild —
# the binary is already symlinked from the store and works fine.
# Turn the pre-run verification off so `pnpm build` / `pnpm test`
# don't get blocked by a non-issue.
verify-deps-before-run=false
